+def _take(client: Client) -> tuple[int, str | None, str | None]:
+    """Take the ticks in the opening of `client` and return the final tick, state digest, and
+    request identity (proposed profile revision 4). A declined take names the term; try again."""
+    granted = client.enabled.get(FEATURE)
+    if type(granted) is not dict or type(granted.get("term")) is not int:
+        raise ProtocolError("the owner did not enable ncp.lockstep revision 4")
+    term = granted["term"]
+    for _ in range(TAKE_ATTEMPTS):
+        try:
+            body = client.call(TAKE, {"term": term}).body
+        except Declined as declined:
+            moved = declined.body.get(FEATURE) if type(declined.body) is dict else None
+            if type(moved) is not dict or type(moved.get("term")) is not int:
+                raise
+            term = moved["term"]
+            continue
+        if (type(body) is not dict or type(body.get("tick")) is not int or not _state_ok(body.get("state"))
+                or body.get("term") != term + 1):
+            raise ProtocolError("the take response does not carry the clock")
+        return body["tick"], body.get("state"), body.get("request")
+    raise ProtocolError("the term keeps moving: another client takes the ticks")
