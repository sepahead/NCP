diff --git a/scripts/check_ncp_system_design_pdf.sh b/scripts/check_ncp_system_design_pdf.sh
index 2f9587c..46891da 100755
--- a/scripts/check_ncp_system_design_pdf.sh
+++ b/scripts/check_ncp_system_design_pdf.sh
@@ -5,7 +5,7 @@ ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
 SOURCE="docs/publication/ncp-system-design.tex"
 STYLE="docs/publication/ncp-report.sty"
 COMMITTED="output/pdf/ncp-system-design.pdf"
-SOURCE_DATE_EPOCH_VALUE="1786924800"
+SOURCE_DATE_EPOCH_VALUE="1787356800"
 MODE="${1:---check}"
 
 case "$MODE" in
@@ -40,10 +40,13 @@ trap cleanup EXIT
 
 figures=(
     admission-light
+    closed-loop-light
+    closed-loop-invariants-light
     ecosystem-light
     fsm-light
     lifecycle-light
     overview-light
+    purpose-light
     runtime-light
     sequence-light
     topology-light
@@ -124,8 +127,12 @@ pdftotext -layout "$BUILT" "$BUILD_DIR/built.txt"
 sentinels=(
     "NCP 1.0 System Design"
     "PROPOSED B01 DESIGN"
+    "Causal closed-loop system model"
     "Finite memory and queue isolation"
-    "Twenty-lens design review"
+    "Fifty-lens design review"
+    "Publication-scale system plate atlas"
+    "Visual communication method"
+    "SYSTEM PLATE 12"
     "NOT RUN"
     "The equations expose the design accounting used here."
 )
@@ -211,6 +218,56 @@ if ! grep -F 'Page size:       595.276 x 841.89 pts (A4)' \
     echo "NCP system-design PDF check: page geometry is not A4" >&2
     exit 1
 fi
+PAGE_COUNT="$(awk '/^Pages:/ {print $2}' "$BUILD_DIR/built.info.full")"
+LANDSCAPE_PLATE_COUNT="$(
+    pdfinfo -f 1 -l "$PAGE_COUNT" "$BUILT" \
+        | awk '/^Page +[0-9]+ rot: +90$/ {count += 1} END {print count + 0}'
+)"
+# GNU/BSD grep prints zero but returns status 1 when there are no matches.
+# A valid all-landscape or all-portrait atlas must not trip `set -e` merely
+# because one orientation count is zero.
+LANDSCAPE_PLATE_EXPECTED="$(grep -c '^\\NcpPlate{' "$ROOT/$SOURCE" || true)"
+PORTRAIT_PLATE_EXPECTED="$(grep -c '^\\NcpPortraitPlate{' "$ROOT/$SOURCE" || true)"
+if ((LANDSCAPE_PLATE_EXPECTED + PORTRAIT_PLATE_EXPECTED != ${#figures[@]})); then
+    echo "NCP system-design PDF check: plate orientation declarations do not cover all figures" >&2
+    exit 1
+fi
+if [[ "$LANDSCAPE_PLATE_COUNT" != "$LANDSCAPE_PLATE_EXPECTED" ]]; then
+    echo "NCP system-design PDF check: expected $LANDSCAPE_PLATE_EXPECTED landscape plates, found $LANDSCAPE_PLATE_COUNT" >&2
+    exit 1
+fi
+PLATE_PAGE_COUNT=0
+for page in $(seq 1 "$PAGE_COUNT"); do
+    PLATE_ID="$(
+        pdftotext -f "$page" -l "$page" -layout "$BUILT" - \
+            | sed -nE 's/.*SYSTEM PLATE ([0-9][0-9]).*/\1/p' \
+            | head -n 1
+    )"
+    if [[ -z "$PLATE_ID" ]]; then
+        continue
+    fi
+    PLATE_PAGE_COUNT=$((PLATE_PAGE_COUNT + 1))
+    PAGE_ROTATION="$(
+        pdfinfo -f "$page" -l "$page" "$BUILT" \
+            | awk -v page="$page" '$1 == "Page" && $2 == page && $3 == "rot:" {print $4}'
+    )"
+    if grep -F "\\NcpPortraitPlate{$PLATE_ID}" "$ROOT/$SOURCE" >/dev/null; then
+        EXPECTED_ROTATION=0
+    elif grep -F "\\NcpPlate{$PLATE_ID}" "$ROOT/$SOURCE" >/dev/null; then
+        EXPECTED_ROTATION=90
+    else
+        echo "NCP system-design PDF check: rendered plate $PLATE_ID has no source declaration" >&2
+        exit 1
+    fi
+    if [[ "$PAGE_ROTATION" != "$EXPECTED_ROTATION" ]]; then
+        echo "NCP system-design PDF check: plate $PLATE_ID has rotation $PAGE_ROTATION, expected $EXPECTED_ROTATION" >&2
+        exit 1
+    fi
+done
+if [[ "$PLATE_PAGE_COUNT" != "${#figures[@]}" ]]; then
+    echo "NCP system-design PDF check: expected ${#figures[@]} rendered plate pages, found $PLATE_PAGE_COUNT" >&2
+    exit 1
+fi
 if ! grep -F 'JavaScript:      no' "$BUILD_DIR/built.info.full" >/dev/null; then
     echo "NCP system-design PDF check: PDF contains or may contain JavaScript" >&2
     exit 1
@@ -301,7 +358,7 @@ PY
 esac
 
 DIGEST="$({ shasum -a 256 "$BUILT" 2>/dev/null || sha256sum "$BUILT"; } | awk '{print $1}')"
-PAGES="$(pdfinfo "$BUILT" | awk '/^Pages:/ {print $2}')"
+PAGES="$PAGE_COUNT"
 RSVG_VERSION="$(rsvg-convert --version | sed -n '1p')"
 LATEXMK_VERSION="$(latexmk -v | sed -n '1p')"
 
