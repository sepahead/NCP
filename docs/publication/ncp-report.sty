\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ncp-report}[2026/08/17 NCP system-design publication style]

% The report style is intentionally small and print-safe. Color reinforces
% hierarchy, but every state and relationship also has a textual label.
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{colortbl}
\RequirePackage{etoolbox}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{needspace}
\RequirePackage{tabularx}
\RequirePackage{titlesec}
\RequirePackage{xcolor}

\definecolor{NcpNavy}{HTML}{153A5B}
\definecolor{NcpBlue}{HTML}{1C5D87}
\definecolor{NcpCyan}{HTML}{087E8B}
\definecolor{NcpTeal}{HTML}{0D6E72}
\definecolor{NcpAmber}{HTML}{9A5B00}
\definecolor{NcpRed}{HTML}{9B2C2C}
\definecolor{NcpText}{HTML}{1F2933}
\definecolor{NcpMuted}{HTML}{5B6872}
\definecolor{NcpRule}{HTML}{C5D1D9}
\definecolor{NcpSoft}{HTML}{F2F6F8}
\definecolor{NcpCode}{HTML}{F5F7F9}
\definecolor{NcpTableHeader}{HTML}{C9DEE8}
\definecolor{NcpTableStripe}{HTML}{EAF1F4}

\newcommand{\NcpConfigureSections}{%
  \titleformat{\section}
    {\Large\bfseries\color{NcpNavy}}
    {\thesection}{0.72em}{}
    [\vspace{0.12em}\color{NcpRule}\titlerule]
  \titleformat{\subsection}
    {\large\bfseries\color{NcpBlue}}
    {\thesubsection}{0.62em}{}
  \titleformat{\subsubsection}
    {\normalsize\bfseries\color{NcpText}}
    {\thesubsubsection}{0.55em}{}
  \titlespacing*{\section}{0pt}{1.55em}{0.62em}
  \titlespacing*{\subsection}{0pt}{1.15em}{0.38em}
  \titlespacing*{\subsubsection}{0pt}{0.95em}{0.28em}%
  \pretocmd{\section}{\Needspace{6\baselineskip}}{}{}%
  \pretocmd{\subsection}{\Needspace{4\baselineskip}}{}{}%
}

\newcommand{\NcpTableBands}{%
  \rowcolors{2}{NcpTableStripe}{white}%
  \setlength{\extrarowheight}{0.28ex}%
}

\AtBeginEnvironment{tabular}{\NcpTableBands}
\AtBeginEnvironment{tabularx}{\NcpTableBands}
\AtBeginEnvironment{longtable}{\NcpTableBands}

\newcommand{\NcpTableHeaderRow}{\rowcolor{NcpTableHeader}}

\newcommand{\NcpSetRunningHeads}[2]{%
  \pagestyle{fancy}%
  \fancyhf{}%
  \fancyhead[L]{\footnotesize\sffamily\color{NcpMuted}#1}%
  \fancyhead[R]{\footnotesize\sffamily\color{NcpMuted}#2}%
  \fancyfoot[C]{\footnotesize\sffamily\color{NcpMuted}\thepage}%
  \setlength{\headheight}{14pt}%
  \renewcommand{\headrulewidth}{0.38pt}%
  \renewcommand{\headrule}{%
    {\color{NcpRule}\hrule width \headwidth
      height \headrulewidth \vskip-\headrulewidth}}%
  \fancypagestyle{ncpfirst}{%
    \fancyhf{}%
    \fancyfoot[C]{\footnotesize\sffamily\color{NcpMuted}\thepage}%
    \renewcommand{\headrulewidth}{0pt}}%
}

\newcommand{\NcpReportTitle}[2]{%
  {\color{NcpNavy}\fontsize{22}{26}\selectfont\bfseries #1\par}%
  \vspace{0.38em}%
  {\color{NcpText}\large\normalfont #2\par}%
}

\makeatletter
\newcommand{\NcpMakeTitle}{%
  \begingroup
  \thispagestyle{ncpfirst}%
  \setlength{\fboxsep}{0.58em}%
  \noindent\colorbox{NcpNavy}{%
    \parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
      \color{white}\sffamily\small\bfseries
      NCP SYSTEM DESIGN SERIES}}%
  \par\vspace{1.15em}%
  {\raggedright\@title\par}%
  \vspace{0.9em}%
  {\raggedright\small\color{NcpMuted}\@author\hfill\@date\par}%
  \vspace{0.58em}%
  \noindent{\color{NcpCyan}\rule{5.2em}{1.35pt}}%
  {\color{NcpRule}\rule{\dimexpr\linewidth-5.2em\relax}{0.45pt}}%
  \par\vspace{0.72em}%
  \noindent\colorbox{NcpSoft}{%
    \parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
      \color{NcpRed}\sffamily\footnotesize\bfseries
      PROPOSED B01 DESIGN \(\bullet\) UNRELEASED 1.0.0-rc.1
      \(\bullet\) NO RELEASE AUTHORITY}}%
  \par\vspace{0.8em}%
  \endgroup
}

\newcommand{\NcpConfigureAbstract}{%
  \renewcommand{\abstractname}{\color{NcpNavy}Abstract}%
  \BeforeBeginEnvironment{abstract}{%
    \par\smallskip
    \noindent{\color{NcpRule}\rule{\linewidth}{0.6pt}}\par}%
  \AfterEndEnvironment{abstract}{%
    \par\noindent{\color{NcpRule}\rule{\linewidth}{0.4pt}}\par\medskip}%
}

\newcommand{\NcpCallout}[2]{%
  \par\medskip
  \begingroup
  \setlength{\fboxsep}{0.8em}%
  \noindent\colorbox{NcpSoft}{%
    \parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
      {\sffamily\small\bfseries\color{NcpBlue}#1}\par\smallskip
      {\small\color{NcpText}#2}}}%
  \par\medskip
  \endgroup
}

\newcommand{\NcpBoundary}[1]{%
  \par\medskip
  \begingroup
  \setlength{\fboxsep}{0.8em}%
  \noindent\colorbox{NcpSoft}{%
    \parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
      {\sffamily\small\bfseries\color{NcpRed}CLAIM BOUNDARY}\par\smallskip
      {\small\color{NcpText}#1}}}%
  \par\medskip
  \endgroup
}

\newcommand{\NcpFigure}[4]{%
  \begin{figure}[#1]
    \centering
    \setlength{\fboxsep}{0pt}%
    \colorbox{NcpSoft}{\includegraphics[width=#2]{#3}}%
    \caption{#4}
  \end{figure}%
}

\newcommand{\NcpConfigureLinks}{%
  \AtBeginDocument{%
    \@ifpackageloaded{hyperref}{%
      \hypersetup{%
        linkcolor=NcpBlue,
        citecolor=NcpBlue,
        urlcolor=NcpBlue}}{}%
    \@ifpackageloaded{listings}{%
      \lstset{%
        backgroundcolor=\color{NcpCode},
        rulecolor=\color{NcpRule}}%
    }{}%
  }%
}
\makeatother
