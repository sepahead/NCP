      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "source_path",
        "required_scope",
        "required_polarity"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "required_scope": {
          "const": "COMPLETE_PROPOSED_WIRE_OBJECT"
        },
        "required_polarity": {
          "const": "POSITIVE"
        }
      }
    },
    "hostileWireCaseRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "source_path",
        "positive_case_id",
        "mutation_relation",
        "required_scope",
        "required_polarity"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "source_path": {
          "$ref": "#/$defs/relativePath"
        },
        "positive_case_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        },
        "mutation_relation": {
          "const": "EXACTLY_ONE_SEMANTIC_DELTA_FROM_BOUND_POSITIVE"
        },
        "required_scope": {
          "const": "COMPLETE_PROPOSED_WIRE_OBJECT"
        },
        "required_polarity": {
          "const": "NEGATIVE"
        }
      }
    },
    "parserRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "result_path",
        "required_status"
      ],
      "properties": {
        "engine": {
          "enum": [
            "RUST",
            "TYPESCRIPT"
          ]
        },
        "result_path": {
          "$ref": "#/$defs/relativePath"
        },
        "required_status": {
          "const": "PASS"
        }
      }
    },
    "wireRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_path",
        "required_corpus_status",
        "required_source_paths",
        "complete_positive",
        "complete_hostile",
        "rust_parser_evidence",
        "typescript_parser_evidence"
      ],
      "properties": {
        "corpus_path": {
          "$ref": "#/$defs/relativePath"
        },
        "required_corpus_status": {
          "const": "COMPLETE_CURRENT"
        },
        "required_source_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "complete_positive": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/positiveWireCaseRequirement"
          }
        },
        "complete_hostile": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {
            "$ref": "#/$defs/hostileWireCaseRequirement"
          }
        },
        "rust_parser_evidence": {
          "$ref": "#/$defs/parserRequirement"
        },
        "typescript_parser_evidence": {
          "$ref": "#/$defs/parserRequirement"
        }
      }
    },
    "decisionClosureRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adr_source_set_sha256",
        "questions",
        "wire_requirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ADR-0(0[1-9]|1[01])$"
        },
        "adr_source_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "wire_requirements": {
          "$ref": "#/$defs/wireRequirements"
        }
      }
    }
  }
}
