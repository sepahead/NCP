          "minLength": 16,
          "maxLength": 128
        },
        "validation_state": {
          "enum": [
            "OPEN",
            "VALIDATED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validation_state": {
                "const": "OPEN"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/b03Parameter"
                    },
                    {
                      "properties": {
                        "minimum": {
                          "type": "null"
                        },
                        "maximum": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                }
              },
              "identity_eligibility_universes": {
                "items": {
                  "properties": {
                    "eligible_identities": {
                      "maxItems": 0
                    },
                    "eligible_identities_sha256": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "parameters": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/b03Parameter"
                    },
                    {
                      "properties": {
                        "minimum": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "maximum": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      }
                    }
                  ]
                }
              },
              "identity_eligibility_universes": {
                "items": {
                  "properties": {
                    "eligible_identities": {
                      "minItems": 1
                    },
                    "eligible_identities_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            },
            "if": {
              "properties": {
                "identity_eligibility_required": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "identity_eligibility_universes": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "identity_eligibility_universes": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      ]
