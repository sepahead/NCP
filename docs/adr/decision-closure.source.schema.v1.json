            "string"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "b03Deferral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_task",
        "owner_role_id",
        "parameters",
        "identity_eligibility_universes",
        "identity_eligibility_required",
        "equality_at_minimum",
        "equality_at_maximum",
        "below_minimum",
        "above_maximum",
        "arithmetic_overflow",
        "permissive_default",
        "failure_behavior",
        "meaning_change",
