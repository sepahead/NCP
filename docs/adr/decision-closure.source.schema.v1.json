          "type": "boolean"
        },
        "equality_at_minimum": {
          "const": "PASS"
        },
        "equality_at_maximum": {
          "const": "PASS"
        },
        "below_minimum": {
          "const": "REJECT_BEFORE_ALLOCATION"
        },
        "above_maximum": {
          "const": "REJECT_BEFORE_ALLOCATION"
        },
        "arithmetic_overflow": {
          "const": "REJECT_BEFORE_ALLOCATION"
        },
        "permissive_default": {
          "const": false
        },
        "failure_behavior": {
          "const": "REJECT_BEFORE_ALLOCATION"
        },
        "meaning_change": {
