{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sepahead.github.io/NCP/schemas/decision-closure-source.v1.json",
  "title": "NCP B01 non-normative semantic-closure requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "normative",
    "candidate",
    "wire_version",
    "task",
    "claim_boundary",
    "semantic_example_contract",
    "b03_parameter_contract",
    "excluded_no_edge_components",
    "decisions"
  ],
  "properties": {
    "schema": {
      "const": "ncp.b01-decision-closure-source.v1"
    },
    "normative": {
      "const": false
    },
    "candidate": {
      "const": "1.0.0-rc.1"
    },
    "wire_version": {
      "const": "1.0"
    },
    "task": {
      "const": "B01"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 120,
      "maxLength": 1024
    },
    "semantic_example_contract": {
      "$ref": "#/$defs/semanticExampleContract"
    },
    "b03_parameter_contract": {
      "$ref": "#/$defs/b03ParameterContract"
    },
    "excluded_no_edge_components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/excludedComponent"
      }
    },
    "decisions": {
      "description": "Structural envelope only. The bounded generator pins the exact ADR, question, parameter, test, anchor, and source-set inventories before deriving any closure state.",
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/decisionClosureRequirement"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "roleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "closureId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{1,63}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
      "maxLength": 256
    },
    "semanticExampleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "coverage",
        "rejection_observation",
        "engine_requirement",
        "positive_authority",
        "external_effect"
      ],
      "properties": {
        "schema": {
          "const": "ncp.b01-adr-example-semantics-corpus.v1"
        },
        "coverage": {
          "const": "EVERY_MAIN_ADR_JSON_FENCE_HAS_A_SOURCE_BOUND_CASE_AND_REJECTION_OBSERVATION"
        },
        "rejection_observation": {
          "const": "NEGATIVE_CASE_OR_BOUNDED_MUTATION"
        },
        "engine_requirement": {
          "const": "REQUIRED_BY_COMPLETE_LOCAL_GATE_OUTSIDE_REGISTRY_CLOSURE"
        },
        "positive_authority": {
          "const": "NON_AUTHORIZING_EXCERPT_NOT_PRODUCTION_ADMISSION"
        },
        "external_effect": {
          "const": "NONE_LOCAL_CHALLENGE_EVIDENCE_ONLY"
        }
      }
    },
    "b03ParameterContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "value_kinds",
        "envelope_fields",
        "literal_integer_encoding",
        "validated_envelope",
        "future_b03_allocation_binding",
        "future_allocation_constraint",
        "selection_predicate_binding",
        "selection_profile_semantics",
        "identity_set_measure",
        "identity_canonicalization",
        "identity_eligibility_binding",
        "empty_identity_universe_semantics",
        "identity_eligibility_digest_algorithm",
        "identity_eligibility_digest_domain_hex",
        "identity_eligibility_projection_encoding",
        "identity_eligibility_projection_members",
        "future_identity_selection_constraint",
        "global_no_edge_inheritance",
        "future_b03_selection_verifier",
        "absence_and_unknown",
        "required_test_suffixes_by_value_kind"
      ],
      "properties": {
        "schema": {
          "const": "ncp.b01-b03-parameter-contract.v1"
        },
        "value_kinds": {
          "const": [
            "BOUNDED_INTEGER",
            "EXACT_IDENTITY_SET"
          ]
        },
        "envelope_fields": {
          "const": [
            "minimum",
            "maximum"
          ]
        },
        "literal_integer_encoding": {
          "const": "NONNEGATIVE_JSON_SAFE_INTEGER_FOR_BOUNDED_INTEGER_AND_JSON_SAFE_CARDINALITY_FOR_EXACT_IDENTITY_SET"
        },
        "validated_envelope": {
          "const": "KIND_APPROPRIATE_LITERAL_MINIMUM_AND_FINITE_LITERAL_MAXIMUM_WITH_MINIMUM_LTE_MAXIMUM"
        },
        "future_b03_allocation_binding": {
          "const": "OUTSIDE_B01_DECISION_SET"
        },
        "future_allocation_constraint": {
          "const": "MUST_REMAIN_WITHIN_ACCEPTED_ENVELOPE_AND_MUST_NOT_CHANGE_ACCEPTED_MEANING"
        },
        "selection_predicate_binding": {
          "const": "EXACT_PARAMETER_ID_SOURCE_ANCHOR_VALUE_KIND_PROFILE_AND_ELIGIBILITY"
        },
        "selection_profile_semantics": {
          "const": {
            "B03_BOUNDED_INTEGER_SELECTION_V1": "NONNEGATIVE_JSON_SAFE_INTEGER_WITHIN_INCLUSIVE_ACCEPTED_ENVELOPE",
            "B03_EXACT_IDENTITY_SET_SELECTION_V1": "CANONICAL_UNIQUE_SET_SATISFYING_BOUND_SOURCE_PREDICATE_AND_OPTIONAL_EXACT_B01_UNIVERSE_WITH_GLOBAL_NO_EDGE_DENY"
          }
        },
        "identity_set_measure": {
          "const": "CARDINALITY_OF_CANONICAL_UNIQUE_IDENTITIES"
        },
        "identity_canonicalization": {
          "const": "SOURCE_PREDICATE_GRAMMAR_THEN_RAW_BYTE_ASCENDING_UNIQUE"
        },
        "identity_eligibility_binding": {
          "const": "BOUND_SOURCE_PREDICATE_AND_OPTIONAL_EXACT_B01_UNIVERSE_WHEN_VALIDATED"
        },
        "empty_identity_universe_semantics": {
          "const": "BOUND_SOURCE_PREDICATE_IS_THE_ELIGIBILITY_AUTHORITY"
        },
        "identity_eligibility_digest_algorithm": {
          "const": "sha256(domain || u64be(projection_bytes) || projection)"
        },
        "identity_eligibility_digest_domain_hex": {
          "const": "6e63702e6230312d6230332d656c69676962696c6974792d7365742e763100"
        },
        "identity_eligibility_projection_encoding": {
          "const": "UTF8_JSON_SORTED_KEYS_COMPACT_ENSURE_ASCII_FALSE"
        },
        "identity_eligibility_projection_members": {
          "const": [
            "eligible_identities",
            "parameter_id",
            "question_id",
            "value_kind"
          ]
        },
        "future_identity_selection_constraint": {
          "const": "CANONICAL_SET_SATISFYING_BOUND_SOURCE_PREDICATE_OPTIONAL_EXACT_UNIVERSE_AND_CARDINALITY_ENVELOPE"
        },
        "global_no_edge_inheritance": {
          "const": "ALL_SELECTION_PREDICATES_REJECT_MATCHED_EXCLUDED_COMPONENT_ALIASES"
        },
        "future_b03_selection_verifier": {
          "const": "REQUIRED_OUTSIDE_B01_DECISION_SET_BEFORE_ALLOCATION"
        },
        "absence_and_unknown": {
          "const": "REJECT_BEFORE_ALLOCATION"
        },
        "required_test_suffixes_by_value_kind": {
          "const": {
            "BOUNDED_INTEGER": [
              "MIN-EQUALITY",
              "MAX-EQUALITY",
              "BELOW-MINIMUM",
              "ABOVE-MAXIMUM",
              "PREDICATE-REJECT",
              "OVERFLOW",
              "UNKNOWN-DEFAULT-REJECT"
            ],
            "EXACT_IDENTITY_SET": [
              "MIN-EQUALITY",
              "MAX-EQUALITY",
              "BELOW-MINIMUM",
              "ABOVE-MAXIMUM",
              "INELIGIBLE-MEMBER-REJECT",
              "PROHIBITED-MEMBER-REJECT",
              "OVERFLOW",
              "UNKNOWN-DEFAULT-REJECT"
            ]
          }
        }
      }
    },
    "excludedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "canonical_aliases",
        "identity_match_profile",
        "prohibited_review_role_ids",
        "prohibited_edge_classes"
      ],
      "properties": {
        "component_id": {
          "$ref": "#/$defs/roleId"
        },
        "canonical_aliases": {
          "const": [
            "cortexel",
            "sepahead/cortexel"
          ]
        },
        "identity_match_profile": {
          "const": "ASCII_CASEFOLD_SPLIT_ON_NON_ALNUM_TOKEN_EQUALS_COMPONENT_ID"
        },
        "prohibited_review_role_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/roleId"
          }
        },
        "prohibited_edge_classes": {
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONTROL_DEPENDENCY",
              "NCP_ATLAS_OWNER",
              "NCP_AUTHORITY_EDGE",
              "NCP_COMMANDER",
              "NCP_CONSUMER",
              "NCP_DOCUMENTATION_IMPORT_EDGE",
              "NCP_EVIDENCE_EDGE",
              "NCP_EXPORT_EDGE",
              "NCP_IMPLEMENTATION_EDGE",
              "NCP_PACKAGE_DEPENDENCY",
              "NCP_PEER",
              "NCP_RELEASE_EDGE",
              "NCP_ROLE_RECEIPT",
              "NCP_RUNTIME_EDGE",
              "NCP_SEMANTIC_EDGE",
              "NCP_WORK_AUTHORITY",
              "OBSERVATION_EDGE",
              "OBSERVER_GRANT_HOLDER",
              "PROTOCOL_SOURCE_OF_TRUTH"
            ]
          }
        }
      }
    },
    "b03Parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "value_kind",
        "selection_predicate_id",
        "selection_predicate_source_anchor",
        "selection_profile",
        "b03_selection_verifier_required",
        "inherits_excluded_no_edge_components",
        "minimum",
        "maximum",
        "required_tests"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/closureId"
        },
        "value_kind": {
          "enum": [
            "BOUNDED_INTEGER",
            "EXACT_IDENTITY_SET"
          ]
        },
        "selection_predicate_id": {
          "$ref": "#/$defs/closureId"
        },
        "selection_predicate_source_anchor": {
          "$ref": "#/$defs/roleId"
        },
        "selection_profile": {
          "$ref": "#/$defs/closureId"
        },
        "b03_selection_verifier_required": {
          "const": true
        },
        "inherits_excluded_no_edge_components": {
          "const": true
        },
        "minimum": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": [
            "null",
            "integer"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "required_tests": {
          "type": "array",
          "minItems": 7,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/closureId"
          }
        }
      }
    },
    "identityEligibilityUniverse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_id",
        "eligible_identities",
        "eligible_identities_sha256"
      ],
      "properties": {
        "parameter_id": {
          "$ref": "#/$defs/closureId"
        },
        "eligible_identities": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "eligible_identities_sha256": {
          "type": [
            "null",
            "string"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "b03Deferral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_task",
        "owner_role_id",
        "parameters",
        "identity_eligibility_universes",
        "identity_eligibility_required",
        "equality_at_minimum",
        "equality_at_maximum",
        "below_minimum",
        "above_maximum",
        "arithmetic_overflow",
        "permissive_default",
        "failure_behavior",
        "meaning_change",
        "source_anchor",
        "validation_state"
      ],
      "properties": {
        "owner_task": {
          "const": "B03"
        },
        "owner_role_id": {
          "$ref": "#/$defs/roleId"
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/b03Parameter"
          }
        },
        "identity_eligibility_universes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identityEligibilityUniverse"
          }
        },
        "identity_eligibility_required": {
          "type": "boolean"
        },
        "equality_at_minimum": {
          "const": "PASS"
        },
        "equality_at_maximum": {
          "const": "PASS"
        },
        "below_minimum": {
          "const": "REJECT_BEFORE_ALLOCATION"
        },
        "above_maximum": {
          "const": "REJECT_BEFORE_ALLOCATION"
        },
        "arithmetic_overflow": {
          "const": "REJECT_BEFORE_ALLOCATION"
        },
        "permissive_default": {
          "const": false
        },
        "failure_behavior": {
          "const": "REJECT_BEFORE_ALLOCATION"
        },
        "meaning_change": {
          "const": "FORBIDDEN"
        },
        "source_anchor": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "validation_state": {
          "enum": [
            "OPEN",
            "VALIDATED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "validation_state": {
                "const": "OPEN"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/b03Parameter"
                    },
                    {
                      "properties": {
                        "minimum": {
                          "type": "null"
                        },
                        "maximum": {
                          "type": "null"
                        }
                      }
                    }
                  ]
                }
              },
              "identity_eligibility_universes": {
                "items": {
                  "properties": {
                    "eligible_identities": {
                      "maxItems": 0
                    },
                    "eligible_identities_sha256": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "parameters": {
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/b03Parameter"
                    },
                    {
                      "properties": {
                        "minimum": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "maximum": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      }
                    }
                  ]
                }
              },
              "identity_eligibility_universes": {
                "items": {
                  "oneOf": [
                    {
                      "properties": {
                        "eligible_identities": {
                          "maxItems": 0
                        },
                        "eligible_identities_sha256": {
                          "type": "null"
                        }
                      }
                    },
                    {
                      "properties": {
                        "eligible_identities": {
                          "minItems": 1
                        },
                        "eligible_identities_sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "if": {
              "properties": {
                "identity_eligibility_required": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "identity_eligibility_universes": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "identity_eligibility_universes": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question_anchor",
        "statement",
        "state",
        "resolution",
        "resolution_anchor",
        "b03_deferral"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/closureId"
        },
        "question_anchor": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "statement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1024
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "DEFERRED_B03"
          ]
        },
        "resolution": {
          "type": [
            "null",
            "string"
          ],
          "minLength": 10,
          "maxLength": 1024
        },
        "resolution_anchor": {
          "type": [
            "null",
            "string"
          ],
          "minLength": 16,
          "maxLength": 512
        },
        "b03_deferral": {}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "state": {
                  "const": "OPEN"
                },
                "resolution": {
                  "type": "null"
                },
                "resolution_anchor": {
                  "type": "null"
                },
                "b03_deferral": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "state": {
                  "const": "CLOSED"
                },
                "resolution": {
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 1024
                },
                "resolution_anchor": {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 512
                },
                "b03_deferral": {
                  "type": "null"
                }
              }
            },
            {
              "properties": {
                "state": {
                  "const": "DEFERRED_B03"
                },
                "resolution": {
                  "type": "null"
                },
                "resolution_anchor": {
                  "type": "null"
                },
                "b03_deferral": {
                  "$ref": "#/$defs/b03Deferral"
                }
              }
            }
          ]
        }
      ]
    },
    "exampleRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_path",
        "required_corpus_status",
        "required_source_paths",
        "required_case_ids"
      ],
      "properties": {
        "corpus_path": {
          "$ref": "#/$defs/relativePath"
        },
        "required_corpus_status": {
          "const": "COMPLETE_CURRENT"
        },
        "required_source_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "required_case_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^adr(?:00[1-9]|01[01])\\.[a-z0-9][a-z0-9.-]*\\.v1$",
            "maxLength": 128
          }
        }
      }
    },
    "decisionClosureRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adr_source_set_sha256",
        "questions",
        "example_requirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ADR-0(0[1-9]|1[01])$"
        },
        "adr_source_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "example_requirements": {
          "$ref": "#/$defs/exampleRequirements"
        }
      }
    }
  }
}
