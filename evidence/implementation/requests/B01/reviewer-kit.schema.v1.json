{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sepahead.github.io/NCP/schemas/b01-reviewer-kit.v1.json",
  "title": "NCP B01 non-authorizing reviewer kit",
  "description": "This closed schema validates deterministic review preparation. The kit supplies no human response or authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "normative",
    "authorizing",
    "minimum_only",
    "claim_boundary",
    "generated_by",
    "inputs",
    "subject_cut",
    "counts",
    "ordering",
    "materialization_contract",
    "decisions",
    "slots"
  ],
  "properties": {
    "schema": {
      "const": "ncp.b01-reviewer-kit.v1"
    },
    "normative": {
      "const": false
    },
    "authorizing": {
      "const": false
    },
    "minimum_only": {
      "const": true
    },
    "claim_boundary": {
      "const": "STRUCTURAL_REVIEW_PREPARATION_ONLY_NO_REVIEWER_DECISION_IDENTITY_ROLE_AUTHORITY_INDEPENDENCE_EVIDENCE_AUTHENTICATION_ADR_ACCEPTANCE_TASK_STATUS_PROTOCOL_CHANGE_OR_RELEASE_AUTHORITY"
    },
    "generated_by": {
      "$ref": "#/$defs/fileIdentity"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_request",
        "reviewer_kit_schema",
        "review_response_schema",
        "review_source_candidate_schema",
        "decision_registry_generator",
        "decision_registry_schema"
      ],
      "properties": {
        "review_request": {
          "$ref": "#/$defs/fileIdentity"
        },
        "reviewer_kit_schema": {
          "$ref": "#/$defs/fileIdentity"
        },
        "review_response_schema": {
          "$ref": "#/$defs/fileIdentity"
        },
        "review_source_candidate_schema": {
          "$ref": "#/$defs/fileIdentity"
        },
        "decision_registry_generator": {
          "$ref": "#/$defs/fileIdentity"
        },
        "decision_registry_schema": {
          "$ref": "#/$defs/fileIdentity"
        }
      }
    },
    "subject_cut": {
      "$ref": "#/$defs/subjectCut"
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisions",
        "role_obligations",
        "minimum_identity_slots",
        "independent_obligations",
        "minimum_independent_identity_slots",
        "minimum_evidence_requirements"
      ],
      "properties": {
        "decisions": {
          "const": 11
        },
        "role_obligations": {
          "const": 52
        },
        "minimum_identity_slots": {
          "const": 53
        },
        "independent_obligations": {
          "const": 5
        },
        "minimum_independent_identity_slots": {
          "const": 6
        },
        "minimum_evidence_requirements": {
          "const": 112
        }
      }
    },
    "ordering": {
      "const": "PACKET_DECISION_ORDER_THEN_REQUIRED_REVIEW_ORDER_THEN_ONE_BASED_IDENTITY_ORDINAL"
    },
    "materialization_contract": {
      "$ref": "#/$defs/materializationContract"
    },
    "decisions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "slots": {
      "type": "array",
      "minItems": 53,
      "maxItems": 53,
      "items": {
        "$ref": "#/$defs/slot"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "roleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "modulePaths": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docs/adr/modules/adr-0(0[1-9]|1[01])-[a-z0-9-]+\\.md$",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "adrSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/adr/(?:00(0[1-9]|1[01])-[a-z0-9-]+|modules/adr-0(0[1-9]|1[01])-[a-z0-9-]+)\\.md$",
          "maxLength": 256
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        },
        "kind": {
          "enum": [
            "main",
            "module"
          ]
        }
      }
    },
    "adrSourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "decision_id",
        "sources",
        "digest_algorithm",
        "domain_hex",
        "sha256"
      ],
      "properties": {
        "schema": {
          "const": "ncp.b01-adr-source-set.v1"
        },
        "decision_id": {
          "type": "string",
          "pattern": "^ADR-0(0[1-9]|1[01])$"
        },
        "domain_hex": {
          "const": "6e63702e6230312d6164722d736f757263652d7365742e763100"
        },
        "digest_algorithm": {
          "const": "sha256(domain || u64be(projection_bytes) || projection)"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/adrSource"
                },
                {
                  "properties": {
                    "kind": {
                      "const": "main"
                    }
                  }
                }
              ]
            }
          ],
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/adrSource"
              },
              {
                "properties": {
                  "kind": {
                    "const": "module"
                  }
                }
              }
            ]
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_set_sha256",
        "adr_content_sha256",
        "adr_bytes",
        "adr_source_set",
        "source_commit",
        "source_tree",
        "review_packet_sha256"
      ],
      "properties": {
        "decision_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adr_content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adr_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        },
        "adr_source_set": {
          "$ref": "#/$defs/adrSourceSet"
        },
        "source_commit": {
          "$ref": "#/$defs/gitObject"
        },
        "source_tree": {
          "$ref": "#/$defs/gitObject"
        },
        "review_packet_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "remoteObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizing",
        "claim_boundary",
        "configured_remote",
        "host_key_fingerprint",
        "host_key_line_sha256",
        "local_main_ref",
        "local_tracking_ref",
        "policy",
        "queried_ref",
        "queried_url",
        "repository",
        "retained_observed_commit",
        "state",
        "transport_profile"
      ],
      "properties": {
        "authorizing": {
          "const": false
        },
        "claim_boundary": {
          "type": "string",
          "minLength": 32,
          "maxLength": 512
        },
        "configured_remote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "host_key_fingerprint": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "host_key_line_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "local_main_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "local_tracking_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "queried_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "queried_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retained_observed_commit": {
          "$ref": "#/$defs/gitObject"
        },
        "state": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        },
        "transport_profile": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      }
    },
    "issuanceCurrentness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_ref",
        "policy",
        "remote_observation",
        "resolved_commit",
        "resolved_tree"
      ],
      "properties": {
        "authorized_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policy": {
          "type": "string",
          "minLength": 16,
          "maxLength": 512
        },
        "remote_observation": {
          "$ref": "#/$defs/remoteObservation"
        },
        "resolved_commit": {
          "$ref": "#/$defs/gitObject"
        },
        "resolved_tree": {
          "$ref": "#/$defs/gitObject"
        }
      }
    },
    "subjectCut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_set_sha256",
        "issuance_currentness",
        "packet_commit",
        "packet_tree",
        "proposed_registry",
        "review_packet",
        "zero_review_source_commit",
        "zero_review_source_tree"
      ],
      "properties": {
        "decision_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "issuance_currentness": {
          "$ref": "#/$defs/issuanceCurrentness"
        },
        "packet_commit": {
          "$ref": "#/$defs/gitObject"
        },
        "packet_tree": {
          "$ref": "#/$defs/gitObject"
        },
        "proposed_registry": {
          "$ref": "#/$defs/fileIdentity"
        },
        "review_packet": {
          "$ref": "#/$defs/fileIdentity"
        },
        "zero_review_source_commit": {
          "$ref": "#/$defs/gitObject"
        },
        "zero_review_source_tree": {
          "$ref": "#/$defs/gitObject"
        }
      }
    },
    "requiredEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_requirement_id",
        "kind",
        "required_path_prefix",
        "exclusive"
      ],
      "properties": {
        "evidence_requirement_id": {
          "type": "string",
          "pattern": "^adr-(?:00[1-9]|01[01])\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]{2}\\.(?:role-authorization|external-review-receipt|independence-assessment)$",
          "minLength": 32,
          "maxLength": 160
        },
        "kind": {
          "enum": [
            "ROLE_AUTHORIZATION",
            "EXTERNAL_REVIEW_RECEIPT",
            "INDEPENDENCE_ASSESSMENT"
          ]
        },
        "required_path_prefix": {
          "const": "evidence/implementation/reviews/B01/"
        },
        "exclusive": {
          "const": true
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adr_id",
        "subject"
      ],
      "properties": {
        "adr_id": {
          "type": "string",
          "pattern": "^ADR-0(0[1-9]|1[01])$"
        },
        "subject": {
          "$ref": "#/$defs/reviewSubject"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "adr_id",
        "distinct_identity_group",
        "identity_ordinal",
        "role_id",
        "role_label",
        "requires_independence",
        "required_evidence"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "pattern": "^adr-(?:00[1-9]|01[01])\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]{2}$",
          "minLength": 12,
          "maxLength": 96
        },
        "adr_id": {
          "type": "string",
          "pattern": "^ADR-0(0[1-9]|1[01])$"
        },
        "distinct_identity_group": {
          "type": "string",
          "minLength": 8,
          "maxLength": 96
        },
        "identity_ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "role_id": {
          "$ref": "#/$defs/roleId"
        },
        "role_label": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        },
        "requires_independence": {
          "type": "boolean"
        },
        "required_evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/requiredEvidence"
          }
        }
      }
    },
    "materializationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_selector",
        "machine_injected_source_members",
        "human_response_members",
        "derived_member_forbidden",
        "registry_mutation",
        "output",
        "output_schema",
        "claim_boundary"
      ],
      "properties": {
        "response_selector": {
          "const": "slot_id"
        },
        "machine_injected_source_members": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "adr_id",
              "role_id",
              "subject"
            ]
          }
        },
        "human_response_members": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "review_id",
              "reviewer",
              "decision",
              "conditions",
              "role_authorization",
              "independence_assessment",
              "external_receipt",
              "timestamp_utc",
              "supersedes"
            ]
          }
        },
        "derived_member_forbidden": {
          "const": true
        },
        "registry_mutation": {
          "const": false
        },
        "output": {
          "const": "STDOUT_ONLY_STRUCTURAL_CANDIDATE"
        },
        "output_schema": {
          "const": "ncp.b01-review-source-candidate.v1"
        },
        "claim_boundary": {
          "const": "STRUCTURAL_VALIDATION_ONLY_NO_AUTHORSHIP_ROLE_AUTHORITY_INDEPENDENCE_EXTERNAL_RECEIPT_ADR_ACCEPTANCE_TASK_STATUS_OR_RELEASE_AUTHORITY"
        }
      }
    }
  }
}
