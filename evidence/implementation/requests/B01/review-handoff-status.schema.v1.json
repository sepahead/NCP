{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sepahead.github.io/NCP/schemas/b01-review-handoff-status.v1.json",
  "title": "NCP B01 review handoff status",
  "description": "This closed schema reports one current structural snapshot. It grants no review, task, protocol, or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "normative",
    "authorizing",
    "registry_mutation",
    "snapshot_only",
    "external_verifier_required",
    "history_assurance",
    "review_authentication",
    "claim_boundary",
    "phase",
    "generated_by",
    "subject",
    "inputs",
    "counts",
    "decisions",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "ncp.b01-review-handoff-status.v1"
    },
    "normative": {
      "const": false
    },
    "authorizing": {
      "const": false
    },
    "registry_mutation": {
      "const": false
    },
    "snapshot_only": {
      "const": true
    },
    "external_verifier_required": {
      "const": true
    },
    "history_assurance": {
      "const": "NOT_ESTABLISHED"
    },
    "review_authentication": {
      "const": "NOT_ESTABLISHED"
    },
    "claim_boundary": {
      "const": "CURRENT_STRUCTURAL_SNAPSHOT_ONLY_NO_AUTHENTICATED_REVIEWER_ROLE_AUTHORITY_INDEPENDENCE_APPEND_ONLY_HISTORY_HIGH_WATER_ADR_TASK_PROTOCOL_OR_RELEASE_AUTHORITY"
    },
    "phase": {
      "enum": [
        "ZERO_REVIEW_ISSUANCE",
        "REVIEW_CAPTURE_ACTIVE"
      ]
    },
    "generated_by": {
      "allOf": [
        {
          "$ref": "#/$defs/fileIdentity"
        },
        {
          "properties": {
            "path": {
              "const": "scripts/check_b01_review_handoff.py"
            }
          }
        }
      ]
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "inputs": {
      "$ref": "#/$defs/inputs"
    },
    "counts": {
      "$ref": "#/$defs/counts"
    },
    "decisions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-001"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-002"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-003"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-004"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-005"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-006"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-007"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-008"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-009"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-010"}}}]},
        {"allOf": [{"$ref": "#/$defs/decision"}, {"properties": {"adr_id": {"const": "ADR-011"}}}]}
      ]
    },
    "authority": {
      "$ref": "#/$defs/authority"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "phase": {
            "const": "ZERO_REVIEW_ISSUANCE"
          }
        },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "decisions_accepted": {"const": 0},
              "role_obligations_structurally_satisfied": {"const": 0},
              "identity_slots_structurally_satisfied": {"const": 0},
              "independent_identity_slots_structurally_satisfied": {"const": 0},
              "review_records_total": {"const": 0},
              "active_review_records": {"const": 0},
              "superseded_review_records": {"const": 0},
              "current_subject_review_records": {"const": 0},
              "stale_review_records": {"const": 0},
              "structurally_qualifying_review_records": {"const": 0},
              "active_rejections": {"const": 0},
              "active_open_conditions": {"const": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "const": "REVIEW_CAPTURE_ACTIVE"
          }
        },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "counts": {
            "properties": {
              "review_records_total": {"minimum": 1},
              "active_review_records": {"minimum": 1}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "adrId": {
      "type": "string",
      "pattern": "^ADR-0(0[1-9]|1[01])$"
    },
    "roleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "slotId": {
      "type": "string",
      "pattern": "^adr-(?:00[1-9]|01[01])\\.[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]{2}$",
      "minLength": 12,
      "maxLength": 96
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_set_sha256",
        "review_packet",
        "zero_review_source_commit",
        "zero_review_source_tree"
      ],
      "properties": {
        "decision_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "review_packet": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "docs/adr/B01_REVIEW_PACKET.md"}}}
          ]
        },
        "zero_review_source_commit": {
          "$ref": "#/$defs/gitObject"
        },
        "zero_review_source_tree": {
          "$ref": "#/$defs/gitObject"
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_schema",
        "reviewer_kit",
        "reviewer_kit_generator",
        "review_request",
        "review_request_generator",
        "immutable_git",
        "reviewer_kit_schema",
        "review_response_schema",
        "review_source_candidate_schema",
        "registry_generator",
        "registry_schema",
        "registry_source",
        "proposed_registry"
      ],
      "properties": {
        "status_schema": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "evidence/implementation/requests/B01/review-handoff-status.schema.v1.json"}}}
          ]
        },
        "reviewer_kit": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "evidence/implementation/requests/B01/reviewer-kit.v1.json"}}}
          ]
        },
        "reviewer_kit_generator": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "scripts/generate_b01_reviewer_kit.py"}}}
          ]
        },
        "review_request": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "evidence/implementation/requests/B01/review-request.v1.json"}}}
          ]
        },
        "review_request_generator": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "scripts/generate_b01_review_request.py"}}}
          ]
        },
        "immutable_git": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "scripts/immutable_git.py"}}}
          ]
        },
        "reviewer_kit_schema": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "evidence/implementation/requests/B01/reviewer-kit.schema.v1.json"}}}
          ]
        },
        "review_response_schema": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "evidence/implementation/requests/B01/review-response.schema.v1.json"}}}
          ]
        },
        "review_source_candidate_schema": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "evidence/implementation/requests/B01/review-source-candidate.schema.v1.json"}}}
          ]
        },
        "registry_generator": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "scripts/generate_decision_registry.py"}}}
          ]
        },
        "registry_schema": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "docs/adr/decision-registry.proposed.schema.v1.json"}}}
          ]
        },
        "registry_source": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "docs/adr/decision-registry.source.v1.json"}}}
          ]
        },
        "proposed_registry": {
          "allOf": [
            {"$ref": "#/$defs/fileIdentity"},
            {"properties": {"path": {"const": "docs/adr/decision-registry.proposed.v1.json"}}}
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisions_total",
        "decisions_accepted",
        "role_obligations_total",
        "role_obligations_structurally_satisfied",
        "identity_slots_total",
        "identity_slots_structurally_satisfied",
        "independent_identity_slots_total",
        "independent_identity_slots_structurally_satisfied",
        "review_records_total",
        "active_review_records",
        "superseded_review_records",
        "current_subject_review_records",
        "stale_review_records",
        "structurally_qualifying_review_records",
        "active_rejections",
        "active_open_conditions"
      ],
      "properties": {
        "decisions_total": {
          "const": 11
        },
        "decisions_accepted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "role_obligations_total": {
          "const": 52
        },
        "role_obligations_structurally_satisfied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 52
        },
        "identity_slots_total": {
          "const": 53
        },
        "identity_slots_structurally_satisfied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 53
        },
        "independent_identity_slots_total": {
          "const": 6
        },
        "independent_identity_slots_structurally_satisfied": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "review_records_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "active_review_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "superseded_review_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "current_subject_review_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "stale_review_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "structurally_qualifying_review_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "active_rejections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "active_open_conditions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "label",
        "requires_independence",
        "minimum_distinct_identities",
        "structurally_qualifying_identity_count",
        "minimum_identity_shortage",
        "suggested_next_slot_id"
      ],
      "properties": {
        "role_id": {
          "$ref": "#/$defs/roleId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requires_independence": {
          "type": "boolean"
        },
        "minimum_distinct_identities": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "structurally_qualifying_identity_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "minimum_identity_shortage": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "suggested_next_slot_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/slotId"
            }
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adr_id",
        "title",
        "status",
        "blocker_codes",
        "roles"
      ],
      "properties": {
        "adr_id": {
          "$ref": "#/$defs/adrId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "PROPOSED",
            "ACCEPTED"
          ]
        },
        "blocker_codes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/role"
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_identity_authentication",
        "role_authority",
        "independence",
        "append_only_history",
        "high_water_currentness",
        "b01"
      ],
      "properties": {
        "reviewer_identity_authentication": {
          "const": "NOT_EVALUATED"
        },
        "role_authority": {
          "const": "NOT_EVALUATED"
        },
        "independence": {
          "const": "NOT_EVALUATED"
        },
        "append_only_history": {
          "const": "NOT_PROVED"
        },
        "high_water_currentness": {
          "const": "NOT_PROVED"
        },
        "b01": {
          "const": "NOT_GRANTED"
        }
      }
    }
  }
}
